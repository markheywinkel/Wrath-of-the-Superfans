# Port & öffentliche Adresse (muss HTTPS sein, damit das Word-Add-in funktioniert;
# Bilder aus dem Dokument werden unter PUBLIC_BASE_URL/media/... ausgeliefert)
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000

# Zugangsschutz für die Oberfläche (frei wählen, z. B. `openssl rand -hex 24`).
# Leer lassen = kein Schutz (nur für lokale Tests!)
APP_ACCESS_TOKEN=

# Mailjet-API-Schlüssel (Mailjet → Account Settings → API Key Management)
# Ohne Schlüssel läuft das Tool im Trockenmodus: Es erzeugt MJML/HTML, schickt aber nichts.
MJ_APIKEY_PUBLIC=
MJ_APIKEY_PRIVATE=

# Absender (muss in Mailjet als Absender verifiziert sein)
MJ_SENDER_EMAIL=newsletter@example.com
MJ_SENDER_NAME=Mein Verlag

# Optional: Standard-Empfängerliste (ID aus Mailjet → Kontakte → Listen)
MJ_DEFAULT_LIST_ID=

# Optional: Das MJML zusätzlich im Mailjet-Entwurf (Feld MJMLContent) mitschicken.
# Verschickt wird immer das daraus kompilierte HTML.
MJ_ATTACH_MJML=false

# Wohin die fertigen Newsletter (MJML, HTML, Text, Protokoll) abgelegt werden
OUTPUT_DIR=./output
MEDIA_DIR=./media
